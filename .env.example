# ==============================================================================
# NIT Trichy Order-to-Audit Management System - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and adjust the values for your target deployment environment.
# NEVER commit production passwords or production secret keys to version control!

# ------------------------------------------------------------------------------
# Core Django Application Settings
# ------------------------------------------------------------------------------
# In production, generate a long random secret key (min 50 chars)
SECRET_KEY=change-this-to-a-secure-random-50-character-secret-key-in-production

# Set to False in production environments (Render, Railway, Heroku, VPS, Docker)
DEBUG=True

# Comma-separated list of allowed hostnames/domains
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,.railway.app,.herokuapp.com

# Comma-separated list of trusted CSRF origins (required for HTTPS web requests)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://your-domain.com

# ------------------------------------------------------------------------------
# Database Configuration (12-Factor App & PostgreSQL Support)
# ------------------------------------------------------------------------------
# Option A: DATABASE_URL (Standard for Heroku, Render, Railway, AWS ECS)
# DATABASE_URL=postgresql://nit_user:nit_password@postgres:5432/nit_ordertoaudit_db

# Option B: Individual PostgreSQL parameters
DB_ENGINE=django.db.backends.postgresql
DB_NAME=nit_ordertoaudit_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Toggle to True for quick local development using zero-setup SQLite
USE_SQLITE=True

# ------------------------------------------------------------------------------
# Production Security Toggles (Active when DEBUG=False)
# ------------------------------------------------------------------------------
# Set to True when HTTPS is terminated at load balancer or reverse proxy
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=31536000
